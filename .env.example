# Copy this file to .env.local and fill it in.

# This site's own public address, with no trailing slash. Canonical URLs, the
# sitemap and the search-engine schema are built from it, so it must be the
# domain this copy of the site is served on.
NEXT_PUBLIC_SITE_URL=https://giteducation.org

# --- CMS (cms-techcadd/) ------------------------------------------------------
# Where the CMS API runs, as this server reaches it. With this set, the site
# reads its courses, blog, events, gallery, FAQs and reviews from the CMS and
# files enquiries there. Leave it unset and the site runs on the content built
# into src/lib/*.ts, with no CMS needed.
CMS_API_URL=http://localhost:4000

# The same API as a visitor's browser reaches it — uploaded images load from
# here. Usually identical to CMS_API_URL; differs only when the server talks to
# the CMS over a private address.
NEXT_PUBLIC_CMS_URL=http://localhost:4000

# Shared with the CMS (REVALIDATE_SECRET in cms-techcadd/cms-api/.env — the two
# must match). The CMS sends it to /api/revalidate after each save so edits
# appear on the site straight away.
REVALIDATE_SECRET=generate-a-long-random-string

# --- Local enquiries table (optional fallback) --------------------------------
# Only used when CMS_API_URL is unset or the CMS cannot be reached: enquiries
# are then saved to `form_submissions` (see database/schema.sql).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=giteducation
