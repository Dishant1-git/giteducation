# Copy to .env and fill in. The API validates all of this at boot and exits
# with a clear message rather than failing on the first request.

NODE_ENV=development
PORT=4000

# Where the CMS runs. Comma-separated, because Vite falls back to 5174/5175
# when 5173 is taken and the browser would otherwise block every request.
# The CMS admin, and the website itself — blog comments are posted from a
# visitor's browser straight to this API, so the site's origin belongs here too.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# --- database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Quote it. A '#' outside quotes starts a comment, which silently truncates
# the password and produces a confusing access-denied error.
DB_PASSWORD=
DB_NAME=giteducation_cms

# --- sessions ---------------------------------------------------------------
# At least 16 characters. Changing it signs everyone out.
COOKIE_SECRET=replace-with-a-long-random-string
SESSION_DAYS=7

# Sign-in attempts per IP per 15 minutes. Unset means 10 in production and
# 200 in development, where the only thing it throttles is you.
# LOGIN_ATTEMPTS_PER_15_MIN=10

# A second, shared password in front of the enquiries module (leads' names,
# phones and emails). REQUIRED in production — the API refuses to boot
# without it there, because the built-in development default is public in
# this repo's git history and protects nothing once the app is live.
ENQUIRIES_LOCK_PASSWORD=replace-with-a-real-password

# --- first admin account (db:seed) ------------------------------------------
# Read once, by `npm run db:seed`, to create the first Super Admin — not by
# the API itself. Leave unset in development and the seed uses a fixed demo
# login it prints to the console. In production, ALWAYS set SEED_PASSWORD
# yourself before seeding: an unset SEED_PASSWORD in production still seeds a
# working account (so a first deploy is never locked out), but with a
# generated password rather than the well-known development default.
# SEED_EMAIL=admin@example.com
# SEED_USERNAME=admin
# SEED_PASSWORD=replace-with-a-real-password
# SEED_NAME=Admin

# --- uploads ----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# --- email (optional) -------------------------------------------------------
# Without SMTP_HOST the CMS still runs and mail is logged to the console
# instead of sent, so password reset can be tested without a mail server.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=GIT Education CMS <no-reply@giteducation.org>

# Where to tell the website that content changed. Optional: without these the
# site picks changes up when its own cache expires instead of immediately.
SITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=generate-a-long-random-string
